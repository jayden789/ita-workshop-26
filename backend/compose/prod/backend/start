CRLF #!/bin/sh

set -o errexit
set -o nounset

# Prepare static assets
python manage.py collectstatic --no-input

# Don't automatically run migrations in prod

# Load global config data (idempotent)
python manage.py load_config_data

# Run data setup commands (must be idempotent and preserve data integrity)
python manage.py makemigrations
python manage.py migrate
